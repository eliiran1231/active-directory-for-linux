<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RECORDED_MICROSOFT_ORACLE</DefineConstants>
    <!-- Preserve the existing friend-assembly name; no production access change. -->
    <AssemblyName>AdForLinux.DifferentialTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="../../src/AdForLinux.DirectoryServices/AdForLinux.DirectoryServices.csproj" />
    <ProjectReference Include="../../src/AdForLinux.DirectoryServices.AccountManagement/AdForLinux.DirectoryServices.AccountManagement.csproj" />
    <!-- Deliberate exact allowlist. Never glob the live differential directory. -->
    <Compile Include="../AdForLinux.DifferentialTests/PrincipalValueCollectionTraversalAndCopyComparisonTests.cs" Link="PrincipalValueCollectionTraversalAndCopyComparisonTests.cs" />
    <Compile Include="../AdForLinux.DifferentialTests/ResultValueEnumeratorComparisonTests.cs" Link="ResultValueEnumeratorComparisonTests.cs" />
    <Compile Include="../AdForLinux.DifferentialTests/PrincipalValueCollectionCopyFailureComparisonTests.cs" Link="PrincipalValueCollectionCopyFailureComparisonTests.cs" />
    <Compile Include="../AdForLinux.DifferentialTests/GroupConstructorValidationComparisonTests.cs" Link="GroupConstructorValidationComparisonTests.cs" />
    <Compile Include="RecordedMicrosoftOracle.cs" />
    <EmbeddedResource Include="results/run202-net8.0.json" LogicalName="DifferentialOracle.net8.0.json" />
    <EmbeddedResource Include="results/run202-net10.0.json" LogicalName="DifferentialOracle.net10.0.json" />
    <EmbeddedResource Include="results/manifest.json" LogicalName="DifferentialOracle.manifest.json" />
  </ItemGroup>
</Project>
